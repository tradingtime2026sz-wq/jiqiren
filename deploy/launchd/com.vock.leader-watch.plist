<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.vock.leader-watch</string>
  <!-- 时代领袖发言采集：每 5 分钟抓一轮 Google News，新原话记到 ~/Codes/reports/盘前作战卡/<D>/leaders_raw.jsonl，
       不推群（WQ 10-25：盘前由裁判浓缩进作战卡）。全天候，这些人不分盘前盘后说话。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/vock/Codes/tiger-review/.venv/bin/python</string>
    <string>-m</string>
    <string>tiger_review</string>
    <string>leaders</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/vock/Codes/tiger-review</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/vock/Codes/tiger-review/data/logs/leader-watch.launchd.out.log</string>
  <key>StandardErrorPath</key><string>/Users/vock/Codes/tiger-review/data/logs/leader-watch.launchd.err.log</string>
</dict>
</plist>
